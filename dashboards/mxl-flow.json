        }
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "State",
      "description": "Active: head index advancing. Stalled: present but not advancing. Removed: gone from the domain.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (node, domain) (label_replace(\n  mxl_flow_present{flow_id=\"$flow\", node=~\"$node\"} + mxl_flow_active{flow_id=\"$flow\", node=~\"$node\"},\n  \"domain\", \"$1\", \"domain\", \"/dev/shm/(.*)\"))",
          "refId": "A",
          "legendFormat": "{{node}} \u00b7 {{domain}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Removed",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "Stalled",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "Active",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency",
      "description": "How far the head index trails the current time, converted with the grain rate. A copy made by replication trails its source by the transfer time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (node, domain) (label_replace(\n  mxl_flow_latency_grains{flow_id=\"$flow\", node=~\"$node\"} / (mxl_flow_rate_num{flow_id=\"$flow\", node=~\"$node\"} / mxl_flow_rate_den{flow_id=\"$flow\", node=~\"$node\"}) * 1000 and on(flow_id, node, domain, pod) (mxl_flow_present{flow_id=\"$flow\", node=~\"$node\"} == 1),\n  \"domain\", \"$1\", \"domain\", \"/dev/shm/(.*)\"))",
          "refId": "A",
          "legendFormat": "{{node}} \u00b7 {{domain}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rate vs nominal",
      "description": "Head index advance rate divided by the declared rate. 100% means the writer keeps up with real time. Jitter of a few tenths of a percent is scrape timing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (node, domain) (label_replace(\n  rate(mxl_flow_head_index_grains{flow_id=\"$flow\", node=~\"$node\"}[$__rate_interval]) / (mxl_flow_rate_num{flow_id=\"$flow\", node=~\"$node\"} / mxl_flow_rate_den{flow_id=\"$flow\", node=~\"$node\"}) and on(flow_id, node, domain, pod) (mxl_flow_present{flow_id=\"$flow\", node=~\"$node\"} == 1),\n  \"domain\", \"$1\", \"domain\", \"/dev/shm/(.*)\"))",
          "refId": "A",
          "legendFormat": "{{node}} \u00b7 {{domain}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0.95,
            "axisSoftMax": 1.05
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Write age",
      "description": "Time between the exporter's collection and the last write. A healthy writer stays around one grain period.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (node, domain) (label_replace(\n  clamp_min(timestamp(mxl_flow_last_write_time_ns{flow_id=\"$flow\", node=~\"$node\"}) - (mxl_flow_last_write_time_ns{flow_id=\"$flow\", node=~\"$node\"} / 1e9 - 37), 0) and on(flow_id, node, domain, pod) mxl_flow_ring_buffer_size_grains{flow_id=\"$flow\", node=~\"$node\"} and on(flow_id, node, domain, pod) (mxl_flow_present{flow_id=\"$flow\", node=~\"$node\"} == 1),\n  \"domain\", \"$1\", \"domain\", \"/dev/shm/(.*)\"))",
          "refId": "A",
          "legendFormat": "{{node}} \u00b7 {{domain}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "noValue": "Only reported for discrete (video and data) flows"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Read age",
      "description": "Time between the exporter's collection and the last read. It grows without bound when nothing reads the copy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (node, domain) (label_replace(\n  clamp_min(timestamp(mxl_flow_last_read_time_ns{flow_id=\"$flow\", node=~\"$node\"}) - (mxl_flow_last_read_time_ns{flow_id=\"$flow\", node=~\"$node\"} / 1e9 - 37), 0) and on(flow_id, node, domain, pod) mxl_flow_ring_buffer_size_grains{flow_id=\"$flow\", node=~\"$node\"} and on(flow_id, node, domain, pod) (mxl_flow_present{flow_id=\"$flow\", node=~\"$node\"} == 1),\n  \"domain\", \"$1\", \"domain\", \"/dev/shm/(.*)\"))",
          "refId": "A",
          "legendFormat": "{{node}} \u00b7 {{domain}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "noValue": "Only reported for discrete (video and data) flows"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
